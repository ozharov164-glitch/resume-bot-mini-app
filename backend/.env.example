BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxYZ
BOT_USERNAME=myresumebot

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_APP_URL=https://yourdomain.ru
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-v3.2
OPENROUTER_PROVIDER_ONLY=parasail,alibaba,deepseek,morph
OPENROUTER_MAX_TOKENS=2500

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

JWT_SECRET=replace-with-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

APP_URL=https://yourdomain.ru
FRONTEND_URL=https://your-username.github.io
DEBUG=true

YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=
YOKASSA_RETURN_URL=https://your-username.github.io/resumebot/

STARS_PRICE_SINGLE_PDF=99
STARS_PRICE_SUBSCRIPTION=199

FOUNDER_TELEGRAM_IDS=7595981350

# Groq STT for voice input (comma-separated, first = primary, auto-fallback)
GROQ_API_KEYS=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_PUNCTUATE_MODEL=llama-3.1-8b-instant
# HTTP proxy for Groq, e.g. http://user:pass@host:port
GROQ_PROXY_URL=
