[Unit]
Description=ResumeBot FastAPI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/resumebot/backend
EnvironmentFile=/opt/resumebot/backend/.env
ExecStart=/opt/resumebot/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
